# SENTINEL AI - Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Gemini AI Integration (Optional)
# If provided, Gemini generates rich natural language threat intelligence summaries.
# If omitted or invalid, SENTINEL AI seamlessly operates in Deterministic Fallback Mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Threat Intelligence Integrations (Optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Database
DATABASE_URL=sqlite:///./sentinel.db
