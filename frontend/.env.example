# SENTINEL AI - Frontend Environment Configuration Example
# Copy this file to .env.local or configure in Vercel Project Settings

# Deployed Backend API Base URL
# For local development with Vite dev server proxy: leave empty or unset.
# For Vercel production deployment connected to remote backend (Render / Railway / AWS):
# Example: VITE_API_URL=https://sentinel-ai-backend.onrender.com
VITE_API_URL=
